datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id                      String                   @id @default(uuid())
  fullName                String
  title                   String
  summary                 String
  email                   String                   @unique
  phone                   String?
  githubUrl               String?
  linkedinUrl             String?
  academicExperiences     AcademicExperience[]
  professionalExperiences ProfessionalExperience[]
  projects                Project[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model AcademicExperience {
  id           String    @id @default(uuid())
  institution  String
  degree       String
  fieldOfStudy String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfessionalExperience {
  id          String    @id @default(uuid())
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  title        String
  description  String
  technologies String[]
  repoUrl      String?
  deployUrl    String?
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
